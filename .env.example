# Run .venv/bin/python backend/scripts/init_local_env.py to create random local credentials.
# Never copy real secrets into this file.
# Optional overrides (defaults shown):
FDI_DB_PORT=55432
FDI_DB_NAME=fdi
# Web-to-API token verification key (default storage/keys/web-signing-public.pem, created by init_local_env).
# FDI_WEB_PUBLIC_KEY_PATH=
# Extra trusted identity providers for local testing only (comma-separated issuer URLs).
# FDI_ALLOWED_IDP_ISSUERS=
# Answer generation: add your own key to the local .env (never commit it).
# OPENAI_API_KEY=
